/* ============================================================
   Sedivis — Dark Theme
   ============================================================ */

/* -- Base --------------------------------------------------- */
QWidget {
    background-color: @bg;
    color: @fg;
    font-size: 13px;
}

/* -- Main window -------------------------------------------- */
QMainWindow {
    background-color: @bg;
}

/* -- Ribbon tab widget -------------------------------------- */
QWidget#ribbon {
    background-color: @accent;
}

QWidget#ribbon QTabWidget {
    background-color: transparent;
}

QWidget#ribbon QTabWidget::pane {
    border: none;
    background-color: @bg_panel;
}

QWidget#ribbon QTabBar {
    background-color: transparent;
}

QWidget#ribbon QTabBar::tab {
    background-color: transparent;
    color: @on_accent;
    padding: 9px 14px;
    border: none;
    border-bottom: 2px solid transparent;
}

QWidget#ribbon QTabBar::tab:selected {
    color: @fg;
    border-bottom: 2px solid transparent;
    background-color: @bg_panel;
}

QWidget#ribbon QTabBar::tab:hover:!selected {
    color: @on_accent;
    background-color: @accent_hover;
}

/* Tab content widgets and ribbon groups */
QTabWidget > QWidget,
QTabWidget QWidget {
    background-color: @bg_panel;
}

QFrame {
    background-color: @bg_panel;
    border: none;
}

QFrame[frameShape="5"] {  /* QFrame::VLine */
    background-color: @border_inner;
    max-width: 1px;
    margin: 4px 2px;
}

/* -- Status bar --------------------------------------------- */
QStatusBar {
    background-color: @bg_panel;
    color: @fg_muted;
    border-top: 1px solid @border_inner;
    padding: 0 6px;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* -- Ribbon buttons (QToolButton) --------------------------- */
QToolButton {
    background-color: transparent;
    color: @fg;
    border: none;
    border-radius: 3px;
    padding: 4px 6px;
}

QToolButton:hover {
    background-color: @btn_hover;
}

QToolButton:pressed {
    background-color: @accent;
    color: @on_accent;
}

QToolButton:disabled {
    color: @fg_disabled;
}

/* -- Toolbars ----------------------------------------------- */
QToolBar {
    background-color: @bg_panel;
    border: none;
    spacing: 2px;
    padding: 2px;
}

QToolBar QToolButton {
    background-color: transparent;
    border-radius: 3px;
    padding: 3px 5px;
}

QToolBar QToolButton:hover {
    background-color: @btn_hover;
}

/* -- Push buttons ------------------------------------------- */
QPushButton {
    background-color: @bg_button;
    color: @fg;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 4px 12px;
    min-width: 60px;
}

QPushButton:hover {
    background-color: @bg_button_hover;
    border-color: @border_hover;
}

QPushButton:pressed {
    background-color: @accent;
    border-color: @accent;
    color: @on_accent;
}

QPushButton:disabled {
    background-color: @bg_raised;
    color: @fg_disabled;
    border-color: @border_inner;
}

/* -- Tree views (file panel, variables panel) --------------- */
QTreeView,
QTreeWidget {
    background-color: @bg_panel;
    alternate-background-color: @bg_alt;
    color: @fg;
    border: none;
    selection-background-color: @selection;
    selection-color: @fg;
    outline: none;
}

QTreeView::item,
QTreeWidget::item {
    padding: 2px 0;
}

QTreeView::item:hover,
QTreeWidget::item:hover {
    background-color: @bg_hover_tint;
}

QTreeView::item:selected,
QTreeWidget::item:selected {
    background-color: @selection;
}

QTreeView::branch {
    background-color: @bg_panel;
}

/* -- Header views ------------------------------------------- */
QHeaderView {
    background-color: @bg_panel;
    border: none;
}

QHeaderView::section {
    background-color: @bg_raised;
    color: @fg_muted;
    border: none;
    border-right: 1px solid @border_inner;
    padding: 3px 6px;
    font-size: 12px;
}

QHeaderView::section:last {
    border-right: none;
}

/* -- Scroll bars -------------------------------------------- */
QScrollBar:vertical {
    background-color: @bg;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @scrollbar;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: @scrollbar_hover;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: @bg;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: @scrollbar;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @scrollbar_hover;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* -- Labels ------------------------------------------------- */
QLabel {
    background-color: transparent;
    color: @fg;
}

QLabel:disabled {
    color: @fg_disabled;
}

/* -- Tooltips ----------------------------------------------- */
QToolTip {
    background-color: @bg;
    color: @fg;
    border: 1px solid @border;
    padding: 4px;
}
